# Backend only. No secrets belong in VITE_* variables.
VERISIGHT_CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
# Optional local notes SQLite path; keep outside public/static directories.
# VERISIGHT_CASE_DB=/absolute/private/path/response.sqlite3
# Hosted notes/mobile intake remain unavailable until authenticated storage exists.

# Optional local English OCR. Install tesseract + eng language data separately.
VERISIGHT_OCR_ENABLED=1
VERISIGHT_TESSERACT=tesseract

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Private single-reviewer access. Set a strong unique value for any shared host.
# Browser username: verisight. HTTPS is required for non-loopback clients.
VERISIGHT_ACCESS_PASSWORD=
# Summary persistence is off by default; enable only with authorized storage.
VERISIGHT_PERSIST_CASES=0

# Public anon key for signed private-storage uploads (never a service-role key).
SUPABASE_ANON_KEY=
